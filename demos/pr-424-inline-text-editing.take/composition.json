      "text": "Click any text on a slide and you are already editing it."
    },
    {
      "fromMs": 8434,
      "toMs": 11356,
      "text": "Real keystrokes replace the headline, live on the slide."
    },
    {
      "fromMs": 11356,
      "toMs": 12965,
      "text": "The floating toolbar carries size, weight, colour and alignment."
    },
    {
      "fromMs": 12965,
      "toMs": 17110,
      "text": "Enter commits the size and the slide re-lays out instantly."
    },
    {
      "fromMs": 17110,
      "toMs": 19894,
      "text": "Alignment lands on the element you are editing, not the deck."
    },
    {
      "fromMs": 19894,
      "toMs": 22171,
      "text": "Click another text run and the session moves with you."
    },
    {
      "fromMs": 22171,
      "toMs": 24575,
      "text": "Bold applies to the run you are in, nothing else."
    },
    {
      "fromMs": 24575,
      "toMs": 28815,
      "text": "Familiar shortcuts work too: Cmd-B for bold, Cmd-I for italic."
    },
    {
      "fromMs": 28815,
      "toMs": 32150,
      "text": "Escape ends the session; the edits are staged, not saved."
    },
    {
      "fromMs": 32150,
      "toMs": 34990,
      "text": "Save writes every change back into the slide's source file."
    }
