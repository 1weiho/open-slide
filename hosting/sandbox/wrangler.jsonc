{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "autono-slides-sandbox-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "Sandbox", "class_name": "Sandbox" },
      { "name": "Workspaces", "class_name": "Workspace" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sandbox", "Workspace"] }],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "buttons-app-pilot" }],
  "vars": {
    "WORKSPACE_ID": "autono-slides-staging",
    "APP_COMMAND": "[\"/opt/app/node_modules/.bin/open-slide\",\"dev\",\"--host\",\"0.0.0.0\",\"--port\",\"8080\",\"--no-skills-check\"]",
    "CONTENT_PATHS": "[\"slides\",\"themes\",\"assets\"]",
    "AUTH_USERNAME": "pilot"
  }
}
