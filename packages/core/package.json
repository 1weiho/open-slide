{
  "name": "@open-slide/core",
  "version": "2.0.0-beta.1",
  "description": "Compatibility package that automatically provides the open-slide React runtime.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locale": {
      "types": "./dist/locale/index.d.ts",
      "import": "./dist/locale/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./files": {
      "types": "./dist/files/index.d.ts",
      "import": "./dist/files/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./env": {
      "types": "./env.d.ts"
    }
  },
  "bin": {
    "open-slide": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "env.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "slides",
    "presentation",
    "react",
    "vite"
  ],
  "license": "MIT",
  "author": {
    "name": "1weiho",
    "url": "https://github.com/1weiho"
  },
  "homepage": "https://open-slide.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1weiho/open-slide.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/1weiho/open-slide/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@open-slide/react": "workspace:^",
    "@open-slide/shared": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
