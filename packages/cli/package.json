{
  "name": "@open-slide/cli",
  "version": "2.0.0-beta.1",
  "description": "Scaffold an open-slide workspace with Claude Code skills preconfigured.",
  "type": "module",
  "bin": {
    "open-slide": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/sync-template-skills.mjs && tsdown",
    "typecheck": "tsc --noEmit",
    "sync:template-skills": "node scripts/sync-template-skills.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "slides",
    "presentation",
    "claude-code",
    "scaffold"
  ],
  "license": "MIT",
  "author": {
    "name": "1weiho",
    "url": "https://github.com/1weiho"
  },
  "homepage": "https://open-slide.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1weiho/open-slide.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/1weiho/open-slide/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
